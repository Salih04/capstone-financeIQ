e_companypage", "callee": "round", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/CompanyPage.jsx", "source_location": "L299"}, {"caller_nid": "pages_companypage_companypage", "callee": "map", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/CompanyPage.jsx", "source_location": "L331"}, {"caller_nid": "pages_companypage_companypage", "callee": "fromEntries", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/CompanyPage.jsx", "source_location": "L363"}, {"caller_nid": "pages_companypage_companypage", "callee": "map", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/CompanyPage.jsx", "source_location": "L363"}, {"caller_nid": "pages_companypage_companypage", "callee": "map", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/CompanyPage.jsx", "source_location": "L364"}, {"caller_nid": "pages_companypage_companypage", "callee": "find", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/CompanyPage.jsx", "source_location": "L365"}, {"caller_nid": "pages_companypage_companypage", "callee": "filter", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/CompanyPage.jsx", "source_location": "L367"}, {"caller_nid": "pages_companypage_companypage", "callee": "filter", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/CompanyPage.jsx", "source_location": "L368"}, {"caller_nid": "pages_companypage_companypage", "callee": "substring", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/CompanyPage.jsx", "source_location": "L412"}, {"caller_nid": "pages_companypage_companypage", "callee": "map", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/CompanyPage.jsx", "source_location": "L456"}, {"caller_nid": "pages_companypage_companypage", "callee": "(() => {\n                const m = latestMetric\n                if (!m) return null\n                const healthChecks = [\n                  { label: 'Profitability', pass: m.roa > 0 && m.roe > 0, detail: m.roa > 0 ? 'Positive returns' : 'Negative returns' },\n                  { label: 'Liquidity', pass: m.current_ratio >= 1, detail: m.current_ratio >= 1 ? 'Adequate coverage' : 'Below threshold' },\n                  { label: 'Leverage', pass: m.debt_to_equity != null && m.debt_to_equity < 2, detail: m.debt_to_equity < 2 ? 'Manageable debt' : 'High leverage' },\n                  { label: 'Cash Flow', pass: m.cash_flow_margin > 0, detail: m.cash_flow_margin > 0 ? 'Positive cash generation' : 'Negative cash flow' },\n                ]\n                const score = healthChecks.filter(c => c.pass).length\n                const scoreColor = score >= 3 ? 'var(--success)' : score >= 2 ? 'var(--warning)' : 'var(--danger-light)'\n                return (\n                  <Card style={{ padding: '20px 24px', marginBottom: 20, background: 'linear-gradient(135deg, var(--surface-2), rgba(0,245,212,0.03))' }}>\n                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16 }}>\n                      <div>\n                        <div style={{ fontSize: 14, fontWeight: 700, color: 'var(--text-1)', marginBottom: 2 }}>Financial Health Overview</div>\n                        <div style={{ fontSize: 12, color: 'var(--text-3)' }}>Period: {latestMetric?.period}</div>\n                      </div>\n                      <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>\n                        <div style={{ fontSize: '1.6rem', fontWeight: 900, color: scoreColor, fontVariantNumeric: 'tabular-nums' }}>{score}/4</div>\n                        <div style={{ fontSize: 11, color: scoreColor, fontWeight: 600 }}>checks passed</div>\n                      </div>\n                    </div>\n                    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: 10 }}>\n                      {healthChecks.map(c => (\n                        <div key={c.label} style={{ display: 'flex', alignItems: 'center', gap: 8, padding: '10px 12px', background: 'var(--surface-3)', borderRadius: 10 }}>\n                          <div style={{ width: 20, height: 20, borderRadius: '50%', background: c.pass ? 'rgba(43,217,127,0.15)' : 'rgba(239,68,68,0.15)', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: 10, flexShrink: 0 }}>\n                            {c.pass ? '\u2713' : '\u2717'}\n                          </div>\n                          <div>\n                            <div style={{ fontSize: 12, fontWeight: 600, color: 'var(--text-1)' }}>{c.label}</div>\n                            <div style={{ fontSize: 10, color: c.pass ? 'var(--success)' : 'var(--danger-light)' }}>{c.detail}</div>\n                          </div>\n                        </div>\n                      ))}\n                    </div>\n                  </Card>\n                )\n              })", "is_member_call": false, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/CompanyPage.jsx", "source_location": "L493"}, {"caller_nid": "pages_companypage_companypage", "callee": "map", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/CompanyPage.jsx", "source_location": "L533"}, {"caller_nid": "pages_companypage_companypage", "callee": "map", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/CompanyPage.jsx", "source_location": "L560"}, {"caller_nid": "pages