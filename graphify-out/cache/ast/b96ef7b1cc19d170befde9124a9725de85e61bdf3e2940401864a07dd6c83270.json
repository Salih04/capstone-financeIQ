={i} style={{ display: 'flex', gap: 10, alignItems: 'flex-start' }}>\n                    <span style={{ fontSize: 13, color, flexShrink: 0, marginTop: 1, fontWeight: 700 }}>{icon}</span>\n                    <p style={{ fontSize: 13, color: 'var(--text-2)', lineHeight: 1.65, margin: 0 }}>{insight.text}</p>\n                  </div>\n                )\n              })}\n            </div>\n          </Card>\n        )\n      })", "is_member_call": false, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/ScoreResultPage.jsx", "source_location": "L347"}, {"caller_nid": "pages_scoreresultpage_scoreresultpage", "callee": "map", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/ScoreResultPage.jsx", "source_location": "L379"}, {"caller_nid": "pages_scoreresultpage_scoreresultpage", "callee": "map", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/ScoreResultPage.jsx", "source_location": "L392"}, {"caller_nid": "pages_scoreresultpage_scoreresultpage", "callee": "map", "is_member_call": true, "source_file": "/Users/salihcamci/Desktop/CAPSTONE/Capstone_Code/1.frontend/src/pages/ScoreResultPage.jsx", "source_location": "L402"}]}