{
  "schema_version": "1.0.0",
  "task": "R3-REL-01",
  "purpose": "Ownership and regeneration provenance for the generated artifacts under the governed roots. Each entry records which existing Makefile command regenerates a file (or class of files) and whether the file may be hand-edited. This registry records ownership and regeneration provenance only; it does not certify statistical validity, methodology, or predictive value, and asserts no investment merit. The no-reliable-predictive-edge conclusion and the research-support-only boundary are unchanged.",
  "curation": "Hand-curated and reviewed input, like model_confidence_contract.json. NOT a generated file. Every generator_command below cites an existing Makefile target confirmed against the writer in scripts/ or experiments/ (writers were read, not inferred from filenames). Regenerate artifacts only through their owning command; never hand-edit a generated file.",
  "governed_roots": [
    "experiments/results",
    "experiments/results_disagreement",
    "experiments/results_excess",
    "experiments/results_influence",
    "experiments/results_rank_stability",
    "experiments/results_real_terms",
    "experiments/results_regime",
    "data/trusted_clean"
  ],
  "coverage_rule": "Every file under a governed root, excluding experiments/results/runs/**, must be matched by exactly one entry below. An unmatched file (orphan) or a file matched by more than one entry (duplicate ownership) is a governance failure enforced by tests/test_artifact_registry.py.",
  "coverage_exclusions": [
    {
      "glob": "experiments/results/runs/**",
      "reason": "Per-run manifest directories accumulate one directory per 'make research' run. They are governed as a class by the run_manifest entry below and by METHODOLOGY 'Run-directory governance', not enumerated per file."
    }
  ],
  "artifact_class_definitions": {
    "generated": "Deterministic output of a Makefile-invoked generator. Regenerate via generator_command; never hand-edit.",
    "run_manifest": "Per-run provenance manifest written by 'make research'. Generated provenance; immutable once written (see METHODOLOGY run-directory governance).",
    "human_document": "Hand-authored / human-reviewed document. Owned by a human editor, not a generator; hand_edit_forbidden is false.",
    "source_input": "Manually curated raw input. Lives under data/trusted_raw/, outside these governed roots; listed here only for vocabulary completeness.",
    "runtime_output": "Output produced by the running application at request time. Outside these governed roots; listed here only for vocabulary completeness.",
    "proposed_future": "Artifact named by a future task but not yet created. Intentionally has NO registry entry until the file exists, because every entry must match at least one real file."
  },
  "checksum_verification": {
    "rule": "Reports that embed a top-level source_artifacts list of {path, sha256} objects are re-verified: each referenced path is re-hashed and compared to the recorded sha256. A mismatch is stale evidence — regenerate the report via its generator_command or investigate the upstream change. The verification set is auto-discovered across the governed roots by the test, so newly added reports are covered automatically.",
    "known_reports_on_creation": [
      "experiments/results/significance_report.json",
      "experiments/results/friction_report.json",
      "experiments/results_real_terms/real_try/significance_report.json",
      "experiments/results_real_terms/usd/significance_report.json",
      "experiments/results_regime/regime_context_report.json"
    ]
  },
  "reproducibility_note": "Regeneration reproduces content in an environment-qualified sense only: byte identity requires matching Python, platform, and numerical-package versions (see METHODOLOGY 'Reproducibility and run provenance'). This registry does not claim universal byte reproducibility.",
