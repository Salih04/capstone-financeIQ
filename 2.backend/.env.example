DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capstone_db
# Generate a real secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left unset the app generates a random per-process key (JWTs reset on restart).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
