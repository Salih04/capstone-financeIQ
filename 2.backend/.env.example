DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capstone_db
# Generate a real secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left unset the app generates a random per-process key (JWTs reset on restart).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESEARCH_LLM_PROVIDER=openrouter
RESEARCH_LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
RESEARCH_LLM_MODEL=openai/gpt-oss-120b:free
RESEARCH_LLM_TIMEOUT_SECONDS=120
# OpenRouter key. OPENAI_API_KEY is also accepted for compatibility.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=FinanceIQ
