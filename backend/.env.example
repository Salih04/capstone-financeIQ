DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capstone_db
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PORT=8000
BACKEND_RELOAD=1

TRUSTED_DATASETS_DIR=../data/raw/yearly_xlsx
TRUSTED_OUT_DIR=../data/trusted
TRUSTED_COMBINED_CSV=../data/trusted/stocks_2020_2025.csv

# Optional: accept Supabase Auth JWTs on existing FastAPI protected endpoints.
# Use Project Settings > API > JWT Secret. Never expose this in frontend env.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_AUTO_CREATE_USERS=true

RESEARCH_LLM_PROVIDER=none
RESEARCH_LLM_BASE_URL=
RESEARCH_LLM_MODEL=openai/gpt-oss-120b:free
OPENROUTER_API_KEY=
OPENAI_API_KEY=
