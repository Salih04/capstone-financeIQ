DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capstone_db
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PORT=8000
BACKEND_RELOAD=1

TRUSTED_DATASETS_DIR=../data/raw/yearly_xlsx
TRUSTED_OUT_DIR=../data/trusted
TRUSTED_COMBINED_CSV=../data/trusted/stocks_2020_2025.csv

# Optional: accept Supabase Auth JWTs on existing FastAPI protected endpoints.
# Use Project Settings > API > JWT Secret. Never expose this in frontend env.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_AUTO_CREATE_USERS=true

RESEARCH_LLM_PROVIDER=none
RESEARCH_LLM_BASE_URL=
RESEARCH_LLM_MODEL=openai/gpt-oss-120b:free
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── Private / demo access control ──
# Defaults below keep the open read-only demo (dev convenience, nothing breaks).
# For PRIVATE PRODUCTION set:
#   PUBLIC_DEMO_MODE=false
#   REQUIRE_APPROVED_USER=true
#   APPROVED_EMAILS=owner@example.com,teammate@example.com
#   SUPABASE_JWT_SECRET=<Supabase Project Settings > API > JWT Secret>   # REQUIRED in private mode
# Empty APPROVED_EMAILS with REQUIRE_APPROVED_USER=true denies everyone (fail closed).
PUBLIC_DEMO_MODE=true
REQUIRE_APPROVED_USER=false
APPROVED_EMAILS=

# Disable Swagger /docs + /openapi.json in private production.
ENABLE_PUBLIC_DOCS=true

# In-memory rate limiting for expensive endpoints (no external infra).
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Production CORS: exact frontend origin(s), comma-separated. Wildcard "*"
# auto-disables credentials. e.g. CORS_ALLOW_ORIGINS=https://capstone-finance-iq.vercel.app
CORS_ALLOW_ORIGINS=*
