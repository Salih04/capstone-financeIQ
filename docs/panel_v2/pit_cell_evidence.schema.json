{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financeiq.local/panel_v2_pit/pit_cell_evidence.schema.json",
  "title": "panel_v2_pit PIT cell evidence",
  "description": "One evidence record for one security, one feature year, and one GOVERNED FEATURE cell. The `column` domain is restricted to the exact registered 40-feature governed vector: no target column, no PIT metadata name, no eligibility field, no identity helper, and no legacy-unverified name may be recorded here. Legacy vendor-snapshot cells live only in the separate `legacy_unverified.csv` sidecar and are never described by this schema. This is a registration contract only: no panel row and no value has been collected.",
  "x-registration-only": true,
  "x-source-class-taxonomy": {
    "frozen_ids": [
      "SC-1",
      "SC-2",
      "SC-3",
      "SC-4",
      "SC-5",
      "SC-6",
      "SC-7",
      "SC-8",
      "SC-9",
      "SC-10"
    ],
    "value_originating_ids": [
      "SC-4",
      "SC-5",
      "SC-6",
      "SC-7",
      "SC-9",
      "SC-10"
    ],
    "sentinels_forbidden": [
      "MISSING",
      "NOT_APPLICABLE",
      "LEGACY",
      "LEGACY_VENDOR_SNAPSHOT",
      "UNKNOWN",
      "NONE",
      "UNVERIFIED"
    ],
    "note": "SC-1..SC-10 is the entire taxonomy and is never extended. Missing or not-applicable state is carried by is_null, null_reason, and the applicability rule, never by a source_class sentinel. source_class may be null only on a null cell."
  },
  "x-implementation-validator-contract": {
    "status": "DEFERRED_TO_IMPLEMENTATION",
    "not_yet_executed": true,
    "rationale": "JSON Schema Draft 2020-12 has no relational comparison between two instance values, so it cannot prove that knowledge_timestamp <= pit_cutoff_timestamp. The schema layer therefore freezes presence, type, vocabulary, and pit_ok=true for a non-null cell; the ordering predicate itself is deferred to an implementation validator that does not exist yet.",
    "pit_ok_is_computed_never_trusted": true,
    "pit_ok_predicate": "knowledge_timestamp <= pit_cutoff_timestamp, both normalized to Europe/Istanbul",
    "must_fail_closed_when": [
      "the first-public or knowledge timestamp is absent",
      "the pit_cutoff timestamp is absent",
      "the knowledge or first-public timestamp is after the pit_cutoff timestamp",
      "a timestamp timezone cannot be normalized",
      "the evidence chronology is internally inconsistent, including first_publication_timestamp after knowledge_timestamp or retrieval_timestamp before first_publication_timestamp"
    ],
    "additional_deferred_checks": [
      "panel-wide financial_debt_ratio definition_id consistency across every non-null cell",
      "source rounding reconciliation",
      "corporate-action adjustment validation"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "security_id",
    "ticker",
    "feature_year",
    "fiscal_year_of_record",
    "column",
    "value",
    "is_null",
    "null_reason",
    "applicability_rule_id",
    "source_class",
    "source_id",
    "source_document_id",
    "source_ref",
    "first_publication_timestamp",
    "as_of_timestamp",
    "knowledge_timestamp",
    "retrieval_timestamp",
    "document_sha256",
    "extraction_method",
    "transform_id",
    "transform_inputs",
    "pit_cutoff_timestamp",
    "pit_ok",
    "accounting_framework_id",
    "measurement_basis",
    "value_version",
    "measuring_unit_date",
    "currency_code",
    "consolidation_basis",
    "definition_id",
    "definition_text",
    "numerator_definition",
    "denominator_definition",
    "definition_source_document_id",
    "definition_publication_date",
    "frozen_screen_status",
    "conflict_group_id",
    "reviewer",
    "review_date"
  ],
  "$defs": {
    "nullable_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "governed_feature": {
      "type": "string",
      "enum": [
        "benchmark_same_year_return_pct",
        "current_assets",
        "current_ratio",
        "ebitda",
        "ebitda_growth_pct",
        "ebitda_margin",
        "enterprise_value",
        "equity",
        "ev_ebitda",
        "financial_debt_ratio",
        "gross_margin",
        "gross_profit",
        "gross_profit_growth_pct",
        "leverage_ratio",
        "long_term_liabilities",
        "market_cap",
        "net_debt",
        "net_debt_to_ebitda",
        "net_income",
        "net_income_growth_pct",
        "net_margin",
        "non_current_assets",
        "operating_income",
        "operating_income_growth_pct",
        "pb_ratio",
        "pe_ratio",
        "price_adjclose_t",
        "price_data_available",
        "price_drawdown_from_3y_high_pct",
        "price_history_years_available",
        "price_momentum_1y_pct",
        "price_momentum_2y_pct",
        "price_vs_bist100_1y_pct",
        "revenue",
        "revenue_growth_pct",
        "roa",
        "roe",
        "short_term_liabilities",
        "total_assets",
        "working_capital"
      ]
    },
    "source_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "SC-1",
        "SC-2",
        "SC-3",
        "SC-4",
        "SC-5",
        "SC-6",
        "SC-7",
        "SC-8",
        "SC-9",
        "SC-10"
      ]
    }
  },
  "properties": {
    "security_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "ticker": {
      "$ref": "#/$defs/nonempty_string"
    },
    "feature_year": {
      "type": "integer",
      "minimum": 2017
    },
    "fiscal_year_of_record": {
      "type": [
        "integer",
        "null"
      ]
    },
    "column": {
      "$ref": "#/$defs/governed_feature"
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "is_null": {
      "type": "boolean"
    },
    "null_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "NOT_APPLICABLE",
        "MISSING_SOURCE_CLASS_GAP",
        "MISSING_NOT_EVIDENCED",
        "PIT_INADMISSIBLE",
        "PIT_UNVERIFIABLE",
        "FROZEN_SCREEN_REJECTED",
        "CONFLICT_UNADJUDICATED",
        "BASIS_MISMATCH",
        "BASIS_UNKNOWN",
        "DEFINITION_UNAVAILABLE",
        "LEGACY_SOURCE_FORBIDDEN",
        "IDENTITY_UNRESOLVED",
        "STATEMENT_FORMAT_NON_COMPARABLE",
        "WINDOW_INCOMPLETE",
        "BENCHMARK_VARIANT_MISMATCH"
      ]
    },
    "applicability_rule_id": {
      "type": "string",
      "pattern": "^AR-0(0[1-9]|[1-3][0-9]|4[0-8])$"
    },
    "source_class": {
      "$ref": "#/$defs/source_class"
    },
    "source_id": {
      "$ref": "#/$defs/nullable_string"
    },
    "source_document_id": {
      "$ref": "#/$defs/nullable_string"
    },
    "source_ref": {
      "$ref": "#/$defs/nullable_string"
    },
    "first_publication_timestamp": {
      "$ref": "#/$defs/nullable_timestamp"
    },
    "as_of_timestamp": {
      "$ref": "#/$defs/nullable_timestamp"
    },
    "knowledge_timestamp": {
      "$ref": "#/$defs/nullable_timestamp"
    },
    "retrieval_timestamp": {
      "$ref": "#/$defs/nullable_timestamp"
    },
    "document_sha256": {
      "$ref": "#/$defs/nullable_sha256"
    },
    "extraction_method": {
      "$ref": "#/$defs/nullable_string"
    },
    "transform_id": {
      "$ref": "#/$defs/nullable_string"
    },
    "transform_inputs": {
      "$ref": "#/$defs/nullable_string"
    },
    "pit_cutoff_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-12-31T23:59:59\\.999999\\+03:00$"
    },
    "pit_ok": {
      "type": "boolean"
    },
    "accounting_framework_id": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "TFRS_NOMINAL_HISTORICAL_COST",
        "TFRS_TMS29_RESTATED",
        "IFRS_IASB_NOMINAL_HISTORICAL_COST",
        "IFRS_IASB_IAS29_RESTATED",
        "BOBI_FRS_NOMINAL",
        "BOBI_FRS_S25_RESTATED",
        "BDDK_SUPERVISORY_FORMAT_NOMINAL",
        "UNKNOWN"
      ]
    },
    "measurement_basis": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "NOMINAL",
        "INFLATION_RESTATED",
        "UNKNOWN"
      ]
    },
    "value_version": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "ORIGINAL",
        "RESTATED",
        "UNKNOWN"
      ]
    },
    "measuring_unit_date": {
      "$ref": "#/$defs/nullable_date"
    },
    "currency_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "consolidation_basis": {
      "$ref": "#/$defs/nullable_string"
    },
    "definition_id": {
      "$ref": "#/$defs/nullable_string"
    },
    "definition_text": {
      "$ref": "#/$defs/nullable_string"
    },
    "numerator_definition": {
      "$ref": "#/$defs/nullable_string"
    },
    "denominator_definition": {
      "$ref": "#/$defs/nullable_string"
    },
    "definition_source_document_id": {
      "$ref": "#/$defs/nullable_string"
    },
    "definition_publication_date": {
      "$ref": "#/$defs/nullable_date"
    },
    "frozen_screen_status": {
      "type": "string",
      "enum": [
        "PASSED",
        "FROZEN_REPEATED",
        "INSUFFICIENT_PERIODS",
        "NOT_APPLICABLE",
        "NOT_SCREENED"
      ]
    },
    "conflict_group_id": {
      "$ref": "#/$defs/nullable_string"
    },
    "reviewer": {
      "$ref": "#/$defs/nullable_string"
    },
    "review_date": {
      "$ref": "#/$defs/nullable_date"
    }
  },
  "allOf": [
    {
      "title": "a null cell carries a registered null_reason and no value",
      "if": {
        "properties": {
          "is_null": {
            "const": true
          }
        },
        "required": [
          "is_null"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          },
          "null_reason": {
            "type": "string",
            "enum": [
              "NOT_APPLICABLE",
              "MISSING_SOURCE_CLASS_GAP",
              "MISSING_NOT_EVIDENCED",
              "PIT_INADMISSIBLE",
              "PIT_UNVERIFIABLE",
              "FROZEN_SCREEN_REJECTED",
              "CONFLICT_UNADJUDICATED",
              "BASIS_MISMATCH",
              "BASIS_UNKNOWN",
              "DEFINITION_UNAVAILABLE",
              "LEGACY_SOURCE_FORBIDDEN",
              "IDENTITY_UNRESOLVED",
              "STATEMENT_FORMAT_NON_COMPARABLE",
              "WINDOW_INCOMPLETE",
              "BENCHMARK_VARIANT_MISMATCH"
            ]
          }
        },
        "required": [
          "value",
          "null_reason"
        ]
      }
    },
    {
      "title": "a non-null governed feature cell is fail-closed on PIT and source evidence",
      "if": {
        "properties": {
          "is_null": {
            "const": false
          }
        },
        "required": [
          "is_null"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "number"
          },
          "null_reason": {
            "type": "null"
          },
          "pit_ok": {
            "const": true
          },
          "source_class": {
            "type": "string",
            "enum": [
              "SC-4",
              "SC-5",
              "SC-6",
              "SC-7",
              "SC-9",
              "SC-10"
            ]
          },
          "source_id": {
            "$ref": "#/$defs/nonempty_string"
          },
          "source_document_id": {
            "$ref": "#/$defs/nonempty_string"
          },
          "source_ref": {
            "$ref": "#/$defs/nonempty_string"
          },
          "document_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "extraction_method": {
            "$ref": "#/$defs/nonempty_string"
          },
          "first_publication_timestamp": {
            "$ref": "#/$defs/timestamp"
          },
          "knowledge_timestamp": {
            "$ref": "#/$defs/timestamp"
          },
          "retrieval_timestamp": {
            "$ref": "#/$defs/timestamp"
          },
          "pit_cutoff_timestamp": {
            "type": "string",
            "pattern": "^[0-9]{4}-12-31T23:59:59\\.999999\\+03:00$"
          },
          "frozen_screen_status": {
            "enum": [
              "PASSED",
              "NOT_APPLICABLE"
            ]
          }
        },
        "required": [
          "value",
          "pit_ok",
          "source_class",
          "source_id",
          "source_document_id",
          "source_ref",
          "document_sha256",
          "extraction_method",
          "first_publication_timestamp",
          "knowledge_timestamp",
          "retrieval_timestamp",
          "pit_cutoff_timestamp",
          "frozen_screen_status"
        ]
      }
    },
    {
      "title": "source_class may be null only on a null cell",
      "if": {
        "properties": {
          "source_class": {
            "type": "null"
          }
        },
        "required": [
          "source_class"
        ]
      },
      "then": {
        "properties": {
          "is_null": {
            "const": true
          }
        },
        "required": [
          "is_null"
        ]
      }
    },
    {
      "title": "D3 - a non-null financial_debt_ratio requires the registered direct definition evidence",
      "if": {
        "properties": {
          "column": {
            "const": "financial_debt_ratio"
          },
          "is_null": {
            "const": false
          }
        },
        "required": [
          "column",
          "is_null"
        ]
      },
      "then": {
        "properties": {
          "source_class": {
            "const": "SC-10"
          },
          "definition_id": {
            "type": "string",
            "minLength": 1,
            "not": {
              "enum": [
                "UNKNOWN",
                "NONE",
                "NULL",
                "N/A",
                "NA",
                "TBD",
                "DEFAULT"
              ]
            }
          },
          "definition_text": {
            "$ref": "#/$defs/nonempty_string"
          },
          "numerator_definition": {
            "$ref": "#/$defs/nonempty_string"
          },
          "denominator_definition": {
            "$ref": "#/$defs/nonempty_string"
          },
          "definition_source_document_id": {
            "$ref": "#/$defs/nonempty_string"
          },
          "definition_publication_date": {
            "type": "string",
            "format": "date",
            "minLength": 1
          }
        },
        "required": [
          "source_class",
          "definition_id",
          "definition_text",
          "numerator_definition",
          "denominator_definition",
          "definition_source_document_id",
          "definition_publication_date"
        ]
      }
    },
    {
      "title": "definition metadata belongs only to financial_debt_ratio",
      "if": {
        "properties": {
          "column": {
            "not": {
              "const": "financial_debt_ratio"
            }
          }
        },
        "required": [
          "column"
        ]
      },
      "then": {
        "properties": {
          "definition_id": {
            "type": "null"
          },
          "definition_text": {
            "type": "null"
          },
          "numerator_definition": {
            "type": "null"
          },
          "denominator_definition": {
            "type": "null"
          },
          "definition_source_document_id": {
            "type": "null"
          },
          "definition_publication_date": {
            "type": "null"
          }
        }
      }
    }
  ]
}
