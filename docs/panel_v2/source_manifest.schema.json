  },
  "x-registration-only": true,
  "x-implementation-validator-contract": {
    "status": "DEFERRED_TO_IMPLEMENTATION",
    "not_yet_executed": true,
    "note": "These controls are REGISTERED here and IMPLEMENTATION_REQUIRED. No writer, builder, or validator exists at this commit, so none of them is currently executed. A schema can pin the shape of a declaration; it cannot prove the runtime behaviour that produced it.",
    "controls": [
      "source rounding reconciliation",
      "append-only acquisition writer behaviour",
      "no-overwrite behaviour on the raw ledgers and document store",
      "explicit acquisition status on every price observation",
      "corporate-action adjustment validation",
      "full PIT timestamp ordering",
      "panel-wide financial_debt_ratio definition consistency",
      "future transitive no-peek closure over readers that do not exist yet",
      "B1-B8 runtime behaviour"
    ]
  }
}
